{
 "commands": [
  {
   "command": "parameters.add",
   "params": {
    "name": "W",
    "expression": "15 in",
    "comment": "cabinet width, X (front panel to aft panel, outside)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "D",
    "expression": "21 in",
    "comment": "cabinet depth, Y (side panel to side panel, outside)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "H",
    "expression": "32 in",
    "comment": "cabinet height to the top surface, Z"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "t",
    "expression": "0.75 in",
    "comment": "ply thickness. Onshape value (nominal 3/4); MEASURE the sheet before cutting"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "kennel_h",
    "expression": "12 in",
    "comment": "kennel opening height = underside of the shelf"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "fill_w",
    "expression": "1.5 in",
    "comment": "fixed top filler strip along the front panel"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "leg_w",
    "expression": "1.5 in",
    "comment": "side rail drop-leg width (X)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "pin_d",
    "expression": "0.375 in",
    "comment": "steel dowel pin diameter (3/8). UNVERIFIED: measure the pins you buy"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "pin_x",
    "expression": "0.75 in",
    "comment": "pin centre from the front end of the rail. pin_x + groove_edge must equal fill_w or the lid hits the aft panel on the way down"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "pin_z",
    "expression": "1.5 in",
    "comment": "upper pin centre below the top surface"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "pin_pitch",
    "expression": "3 in",
    "comment": "lower pin below the upper pin (v1: 1.5 in). Doubling it halves the pin forces in desk mode"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "leg_h",
    "expression": "pin_z + pin_pitch + 0.75 in",
    "comment": "side rail drop-leg height from the top surface"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "groove_edge",
    "expression": "0.75 in",
    "comment": "drop slot centre from the aft edge (fixed by the lid clearance, see pin_x)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "desk_drop",
    "expression": "9.3125 in",
    "comment": "how far the lid drops in desk mode (as v1: desk surface at H - desk_drop)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "plate_t",
    "expression": "0.1875 in",
    "comment": "aluminium track plate (3/16 6061), let in flush. UNVERIFIED: measure the stock"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "slot_w",
    "expression": "pin_d + 0.15 mm",
    "comment": "slot in the plate: pin + 0.15 mm running clearance"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "relief_w",
    "expression": "pin_d + 0.0625 in",
    "comment": "relief groove in the ply behind the slots (pin never bears on ply)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "relief_d",
    "expression": "0.25 in",
    "comment": "relief groove depth below the plate"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "band_margin",
    "expression": "1.25 in",
    "comment": "plate below the lower track"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "drop_front",
    "expression": "1.25 in",
    "comment": "plate in front of the drop slot centre"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "plate_r",
    "expression": "0.25 in",
    "comment": "plate corner radius inside the panel (>= bit radius)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "scr_d",
    "expression": "0.15 in",
    "comment": "#6 flat-head screw clearance hole"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "scr_cs",
    "expression": "0.28 in",
    "comment": "#6 countersink diameter (82 deg)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "corner_r",
    "expression": "0.25 in",
    "comment": "inside corner radius of the rail"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "bracket_l",
    "expression": "10 in",
    "comment": "folding desk bracket arm. UNVERIFIED: set from the brackets you buy"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "bracket_h",
    "expression": "8 in",
    "comment": "folding desk bracket wall leg. UNVERIFIED"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "bracket_y",
    "expression": "6 in",
    "comment": "bracket centre lines either side of the middle"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "desk",
    "expression": "0",
    "comment": "0 = lid stowed on top, 1 = desk mode (slid out and dropped)",
    "unit": ""
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "lid_dx",
    "expression": "desk*(W - pin_x - groove_edge)",
    "comment": "lid slide (follows desk)"
   }
  },
  {
   "command": "parameters.add",
   "params": {
    "name": "lid_dz",
    "expression": "-desk*desk_drop",
    "comment": "lid drop (follows desk)"
   }
  },
  {
   "command": "material.create",
